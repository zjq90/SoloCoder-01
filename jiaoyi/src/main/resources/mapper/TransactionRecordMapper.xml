<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiaoyi.trade.mapper.TransactionRecordMapper">
    <resultMap id="BaseResultMap" type="com.jiaoyi.trade.entity.TransactionRecord">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="uuid" property="uuid" jdbcType="VARCHAR"/>
        <result column="client_no" property="clientNo" jdbcType="VARCHAR"/>
        <result column="order_no" property="orderNo" jdbcType="VARCHAR"/>
        <result column="channel_code" property="channelCode" jdbcType="VARCHAR"/>
        <result column="channel_order_no" property="channelOrderNo" jdbcType="VARCHAR"/>
        <result column="amount" property="amount" jdbcType="DECIMAL"/>
        <result column="currency" property="currency" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="notify_url" property="notifyUrl" jdbcType="VARCHAR"/>
        <result column="subject" property="subject" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="com.jiaoyi.trade.entity.TransactionRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO transaction_record (
            uuid, client_no, order_no, channel_code, channel_order_no, 
            amount, currency, status, notify_url, subject
        ) VALUES (
            #{uuid}, #{clientNo}, #{orderNo}, #{channelCode}, #{channelOrderNo}, 
            #{amount}, #{currency}, #{status}, #{notifyUrl}, #{subject}
        )
    </insert>

    <update id="updateById" parameterType="com.jiaoyi.trade.entity.TransactionRecord">
        UPDATE transaction_record SET
            channel_code = #{channelCode},
            channel_order_no = #{channelOrderNo},
            status = #{status},
            update_time = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <select id="selectByClientNo" resultMap="BaseResultMap">
        SELECT * FROM transaction_record WHERE client_no = #{clientNo} ORDER BY create_time DESC
    </select>

    <select id="selectByClientNoAndStatus" resultMap="BaseResultMap">
        SELECT * FROM transaction_record WHERE client_no = #{clientNo} AND status = #{status} ORDER BY create_time DESC
    </select>
</mapper>
