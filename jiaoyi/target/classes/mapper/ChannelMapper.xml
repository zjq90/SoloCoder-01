<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiaoyi.trade.mapper.ChannelMapper">
    <resultMap id="BaseResultMap" type="com.jiaoyi.trade.entity.Channel">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="channel_code" property="channelCode" jdbcType="VARCHAR"/>
        <result column="channel_name" property="channelName" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="max_transactions" property="maxTransactions" jdbcType="BIGINT"/>
        <result column="current_transactions" property="currentTransactions" jdbcType="BIGINT"/>
        <result column="priority" property="priority" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="com.jiaoyi.trade.entity.Channel" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO channel (channel_code, channel_name, status, max_transactions, current_transactions, priority)
        VALUES (#{channelCode}, #{channelName}, #{status}, #{maxTransactions}, #{currentTransactions}, #{priority})
    </insert>

    <update id="updateById" parameterType="com.jiaoyi.trade.entity.Channel">
        UPDATE channel SET
            channel_name = #{channelName},
            status = #{status},
            max_transactions = #{maxTransactions},
            current_transactions = #{currentTransactions},
            priority = #{priority},
            update_time = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>
</mapper>
