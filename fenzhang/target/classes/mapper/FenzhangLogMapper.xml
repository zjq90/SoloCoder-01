<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fenzhang.mapper.FenzhangLogMapper">

    <resultMap id="FenzhangLogResultMap" type="com.fenzhang.entity.FenzhangLog">
        <id column="id" property="id"/>
        <result column="log_no" property="logNo"/>
        <result column="batch_no" property="batchNo"/>
        <result column="order_no" property="orderNo"/>
        <result column="agent_code" property="agentCode"/>
        <result column="operation_type" property="operationType"/>
        <result column="log_level" property="logLevel"/>
        <result column="message" property="message"/>
        <result column="detail" property="detail"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="findById" resultMap="FenzhangLogResultMap">
        SELECT * FROM fenzhang_log WHERE id = #{id}
    </select>

    <select id="findByLogNo" resultMap="FenzhangLogResultMap">
        SELECT * FROM fenzhang_log WHERE log_no = #{logNo}
    </select>

    <select id="findByBatchNo" resultMap="FenzhangLogResultMap">
        SELECT * FROM fenzhang_log WHERE batch_no = #{batchNo}
    </select>

    <select id="findByAgentCode" resultMap="FenzhangLogResultMap">
        SELECT * FROM fenzhang_log WHERE agent_code = #{agentCode}
    </select>

    <select id="findByOrderNo" resultMap="FenzhangLogResultMap">
        SELECT * FROM fenzhang_log WHERE order_no = #{orderNo} ORDER BY create_time ASC
    </select>

    <select id="findAll" resultMap="FenzhangLogResultMap">
        SELECT * FROM fenzhang_log
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO fenzhang_log (log_no, batch_no, order_no, agent_code, operation_type, log_level, message, detail)
        VALUES (#{logNo}, #{batchNo}, #{orderNo}, #{agentCode}, #{operationType}, #{logLevel}, #{message}, #{detail})
    </insert>

    <update id="update">
        UPDATE fenzhang_log SET 
            batch_no = #{batchNo},
            order_no = #{orderNo},
            agent_code = #{agentCode},
            operation_type = #{operationType},
            log_level = #{logLevel},
            message = #{message},
            detail = #{detail}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM fenzhang_log WHERE id = #{id}
    </delete>

</mapper>
